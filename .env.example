# PostgreSQL Database Connection URL
# For production VPS: postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE_NAME?schema=public
# For local dev with embedded postgres: postgresql://postgres:password@localhost:5433/findworker?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/findworker?schema=public"

# Better Auth Secret (Random string with at least 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-character-random-secret-key-goes-here"

# Canonical URL of the application
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment (development | production)
NODE_ENV="development"
PORT=3000

# Optional Object Storage (Cloudflare R2 / AWS S3) for production uploads
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=findworker-assets
# S3_PUBLIC_DOMAIN=https://assets.findworker.io

